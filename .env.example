# Copie para .env e preencha com os valores reais (o .env não vai para o Git).
# Valores compartilhados (MONGO_URI, credenciais do Mercado Livre) circulam só por canal privado do time; os de
# produção vão para o professor pelo Blackboard. Detalhes em docs/plano-backend/README.md.

# ===== Todos os devs =====

# MongoDB Atlas: Connect > Drivers > Python. Troque <usuario>, <senha> e <cluster>.
# O IP de cada dev (e o da EC2) precisa estar liberado em Network Access no Atlas.
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Cada dev usa o próprio banco para não misturar dados (ex.: agentic_commerce_dev_ana). Produção: agentic_commerce.
MONGO_DB_NAME=agentic_commerce

# Chave para assinar os tokens JWT. Cada dev gera a sua: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Validade do token de login, em horas.
JWT_EXPIRA_HORAS=8

# Endereços do React liberados pelo CORS, separados por vírgula.
CORS_ORIGINS=http://localhost:5173

# Timeout das chamadas às APIs externas (ViaCEP e catálogo), em segundos.
HTTP_TIMEOUT_SEGUNDOS=8

# ===== M2: catálogo de ofertas =====

# fixo (local, sem rede; padrão), mercadolivre ou dummyjson (sem chave).
CATALOGO_PROVEDOR=fixo
# Só com CATALOGO_PROVEDOR=mercadolivre: app do DevCenter e refresh token (scripts/autorizar_mercadolivre.py).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_REFRESH_TOKEN=
# IDs de vendedores separados por vírgula, se o spike escolher a busca por vendedor.
ML_VENDEDORES=

# ===== M3: pagamento Pix simulado (não usa credencial) =====

PIX_EXPIRACAO_MINUTOS=30
AUTORIZACAO_VALIDADE_MINUTOS=15
SIMULACAO_ENVIO_MINUTOS=2
SIMULACAO_ENTREGA_MINUTOS=5

# ===== Produção (EC2) =====

# 1 quando a API roda atrás do nginx em /api (gera o Location com o prefixo /api). Local: 0.
PROXY_FIX=0

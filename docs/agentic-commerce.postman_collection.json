{
  "info": {
    "name": "Agentic Commerce API",
    "description": "Coleção M1, M2 e M3 com execução sequencial. Cria recursos próprios para remoção, revogação e cancelamento; aguarda a entrega antes de pedir devolução. Configure baseUrl e rode a coleção inteira no Runner com intervalo de 5000 ms entre requisições (no Newman: --delay-request 5000). O ensaio usa contas e recursos de teste no banco configurado. Com os tempos padrão, pode levar cerca de oito minutos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "emailEnsaio",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "politicaId",
      "value": ""
    },
    {
      "key": "solicitacaoId",
      "value": ""
    },
    {
      "key": "autorizacaoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "txid",
      "value": ""
    },
    {
      "key": "chamadoId",
      "value": ""
    },
    {
      "key": "politicaRemocaoId",
      "value": ""
    },
    {
      "key": "solicitacaoCancelamentoId",
      "value": ""
    },
    {
      "key": "solicitacaoAlternativaId",
      "value": ""
    },
    {
      "key": "autorizacaoRevogacaoId",
      "value": ""
    },
    {
      "key": "autorizacaoCancelamentoId",
      "value": ""
    },
    {
      "key": "pedidoCancelamentoId",
      "value": ""
    },
    {
      "key": "inicioEsperaEntrega",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Saúde",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Conta e perfil",
      "item": [
        {
          "name": "Cadastro",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/usuarios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teste\",\n  \"email\": \"{{emailEnsaio}}\",\n  \"senha\": \"senha-forte-123\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('emailEnsaio', 'teste-' + Date.now() + '@exemplo.com');",
                  "pm.collectionVariables.unset('inicioEsperaEntrega');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/sessoes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailEnsaio}}\",\n  \"senha\": \"senha-forte-123\"\n}"
            }
          }
        },
        {
          "name": "Obter perfil",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar perfil com ViaCEP",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/usuarios/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endereco\": {\n    \"cep\": \"01001000\",\n    \"numero\": \"10\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },

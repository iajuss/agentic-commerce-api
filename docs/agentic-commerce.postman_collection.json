{
  "info": {
    "name": "Agentic Commerce API",
    "description": "Coleção unificada de M1, M2 e M3. Para o fluxo manual: Cadastro, Login, Criar política, Criar solicitação (itens), Aprovar solicitação com senha, Criar pedido, Simular pagamento do Pix e Obter pedido. Ajuste baseUrl para http://localhost:5000 ou para a URL de produção quando existir. Revogação, cancelamento e devolução são caminhos alternativos; use novos recursos para cada um.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "emailEnsaio",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "politicaId",
      "value": ""
    },
    {
      "key": "solicitacaoId",
      "value": ""
    },
    {
      "key": "autorizacaoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "txid",
      "value": ""
    },
    {
      "key": "chamadoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Saúde",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Conta e perfil",
      "item": [
        {
          "name": "Cadastro",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/usuarios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teste\",\n  \"email\": \"{{emailEnsaio}}\",\n  \"senha\": \"senha-forte-123\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('emailEnsaio', 'teste-' + Date.now() + '@exemplo.com');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/sessoes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailEnsaio}}\",\n  \"senha\": \"senha-forte-123\"\n}"
            }
          }
        },
        {
          "name": "Obter perfil",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios/me"
          }
        },
        {
          "name": "Atualizar perfil com ViaCEP",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/usuarios/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endereco\": {\n    \"cep\": \"01001000\",\n    \"numero\": \"10\"\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Políticas",
      "item": [
        {
          "name": "Listar políticas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/politicas"
          }
        },
        {
          "name": "Criar política",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('politicaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/politicas",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mercado\",\n  \"teto_por_compra\": 500,\n  \"categorias\": [],\n  \"lojas\": [],\n  \"nivel_autonomia\": \"manual\",\n  \"ativa\": true\n}"
            }
          }
        },
        {
          "name": "Obter política",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/politicas/{{politicaId}}"
          }
        },
        {
          "name": "Substituir política",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/politicas/{{politicaId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Livros\",\n  \"teto_por_compra\": 80,\n  \"categorias\": [\"books\"],\n  \"nivel_autonomia\": \"manual\",\n  \"ativa\": true\n}"
            }
          }
        },
        {
          "name": "Remover política",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/politicas/{{politicaId}}"
          }
        }
      ]
    },
    {
      "name": "Solicitações",
      "item": [
        {
          "name": "Criar solicitação (texto livre)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('solicitacaoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/solicitacoes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"arroz 5kg, 2 leites integrais e detergente\"\n}"
            }
          }
        },
        {
          "name": "Cancelar solicitação",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}"
          }
        },
        {
          "name": "Criar solicitação (itens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('solicitacaoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/solicitacoes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itens\": [\n    {\n      \"descricao\": \"arroz\",\n      \"quantidade\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Listar solicitações",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/solicitacoes"
          }
        },
        {
          "name": "Obter solicitação",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}"
          }
        }
      ]
    },
    {
      "name": "Autorizações",
      "item": [
        {
          "name": "Aprovar solicitação com senha",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const corpo = pm.response.json();",
                  "  pm.collectionVariables.set('autorizacaoId', corpo.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/solicitacoes/{{solicitacaoId}}/autorizacoes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senha\": \"senha-forte-123\"\n}"
            },
            "description": "201 com a autorização limitada. 401 aqui significa senha incorreta, não sessão expirada: o front não deve deslogar o usuário. 422 quando nenhuma política permite a compra."
          }
        },
        {
          "name": "Listar autorizações ativas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/autorizacoes"
          }
        },
        {
          "name": "Obter autorização",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/autorizacoes/{{autorizacaoId}}"
          }
        },
        {
          "name": "Revogar autorização",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/autorizacoes/{{autorizacaoId}}",
            "description": "Só antes de criar o pedido: a solicitação volta a aguardar aprovação. Depois de usada, 409."
          }
        }
      ]
    },
    {
      "name": "Pedidos e Pix",
      "item": [
        {
          "name": "Criar pedido (gera o Pix)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const corpo = pm.response.json();",
                  "  pm.collectionVariables.set('pedidoId', corpo.id);",
                  "  pm.collectionVariables.set('txid', corpo.pix.txid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pedidos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"autorizacao_id\": \"{{autorizacaoId}}\"\n}"
            },
            "description": "Usa a autorização (uso único) e devolve o pedido aguardando pagamento, com o Pix simulado."
          }
        },
        {
          "name": "Simular pagamento do Pix",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/simulador-pix/pagamentos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txid\": \"{{txid}}\"\n}"
            },
            "description": "O pedido vira pago e a solicitação, concluida. Envio em 2 minutos e entrega 5 minutos depois."
          }
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos"
          }
        }
      ]
    },
    {
      "name": "Pós-compra",
      "item": [
        {
          "name": "Obter pedido (comprovante)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}",
            "description": "Aplica as transições simuladas já devidas (expirado, enviado, entregue, devolvido)."
          }
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelado\"\n}"
            },
            "description": "Aguardando pagamento, pago ou enviado. Pago ou enviado gera reembolso simulado."
          }
        },
        {
          "name": "Pedir devolução",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"devolucao_solicitada\",\n  \"motivo\": \"Veio o produto errado.\"\n}"
            },
            "description": "Só para pedido entregue, até 7 dias depois da entrega. Motivo de 3 a 300 caracteres."
          }
        },
        {
          "name": "Abrir chamado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const corpo = pm.response.json();",
                  "  pm.collectionVariables.set('chamadoId', corpo.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/chamados",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assunto\": \"Produto faltando\",\n  \"mensagem\": \"O leite não veio na entrega.\"\n}"
            }
          }
        },
        {
          "name": "Listar chamados do pedido",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/chamados"
          }
        },
        {
          "name": "Obter chamado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/chamados/{{chamadoId}}"
          }
        }
      ]
    },
    {
      "name": "Auditoria",
      "item": [
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auditoria"
          }
        }
      ]
    }
  ]
}

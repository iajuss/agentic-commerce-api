          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const status = pm.response.json().status;",
                  "  const inicio = Number(pm.collectionVariables.get('inicioEsperaEntrega') || Date.now());",
                  "  pm.collectionVariables.set('inicioEsperaEntrega', String(inicio));",
                  "  if (status === 'entregue') {",
                  "    pm.collectionVariables.unset('inicioEsperaEntrega');",
                  "  } else if (Date.now() - inicio >= 540000) {",
                  "    pm.test('Entrega em até nove minutos', function () { throw new Error('Pedido não entregue no prazo'); });",
                  "    pm.execution.setNextRequest(null);",
                  "  } else if (status === 'pago' || status === 'enviado') {",
                  "    pm.execution.setNextRequest('Aguardar entrega');",
                  "  } else {",
                  "    pm.test('Estado de entrega esperado', function () { throw new Error('Estado inesperado: ' + status); });",
                  "    pm.execution.setNextRequest(null);",
                  "  }",
                  "}"
                ]
              }
            }
          ]

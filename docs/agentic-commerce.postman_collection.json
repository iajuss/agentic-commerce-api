          "name": "Criar pedido (gera o Pix)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code < 300) {",
                  "  const corpo = pm.response.json();",
                  "  pm.collectionVariables.set('pedidoId', corpo.id);",
                  "  pm.collectionVariables.set('txid', corpo.pix.txid);",
                  "}"
